generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  weight               Float
  password             String
  preferedClimbingType ClimbingType
  climbingLevel        ClimbingLevel
  isEnabled            Boolean       @default(false)
  createdAt            DateTime      @default(now())
}

enum ClimbingType {
  VOIE
  BLOC
}

enum ClimbingLevel {
  l4a
  l4b
  l4c
  l5a
  l5b
  l5c
  l6a
  l6b
  l6c
  l7a
  l7b
  l7c
  l8a
  l8b
  l8c
  l9a
  l9b
  l9c
}
