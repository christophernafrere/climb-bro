generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  weight               Float
  password             String
  imageUrl             String?
  preferedClimbingType ClimbingType
  climbingLevel        ClimbingLevel
  initiedPartnerships  ClimberPartenarship[] @relation("InitiatedPartenarship")
  receivedPartnerships ClimberPartenarship[] @relation("ReceivedPartenarship")
  climbingSessions     ClimbingSession[]
  isEnabled            Boolean               @default(false)
  createdClimbingSessions ClimbingSession[] @relation("ClimbingSessionCreator")
  createdAt            DateTime              @default(now())
  refreshToken         String?
}

model ClimberPartenarship {
  id          String   @id @default(uuid())
  initiatorId String
  receptorId  String
  isAccepted  Boolean  @default(false)
  createdAt   DateTime @default(now())
  initiator   User     @relation("InitiatedPartenarship", fields: [initiatorId], references: [id])
  receiver    User     @relation("ReceivedPartenarship", fields: [receptorId], references: [id])
  @@unique([initiatorId, receptorId])
}

model ClimbingSession {
  id                  String        @id @default(uuid())
  name                String
  type                ClimbingType
  Date                DateTime
  message             String?
  requiredLevel       ClimbingLevel
  maxClimbers         Int
  onlyForPartnerships Boolean       @default(false)
  creatorId           String
  creator             User          @relation("ClimbingSessionCreator", fields: [creatorId], references: [id])
  climbers            User[]
  createdAt           DateTime      @default(now())
}

enum ClimbingType {
  VOIE
  BLOC
}

enum ClimbingLevel {
  l4a
  l4b
  l4c
  l5a
  l5b
  l5c
  l6a
  l6b
  l6c
  l7a
  l7b
  l7c
  l8a
  l8b
  l8c
  l9a
  l9b
  l9c
}
